    def PhysicsFixedJoint "base_fixed_joint"
    {
        rel physics:body1 = </EStopButton/base>
    }

    def PhysicsPrismaticJoint "press_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 100
        float drive:linear:physics:maxForce = 10000000
        float drive:linear:physics:stiffness = 2000
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </EStopButton/base>
        rel physics:body1 = </EStopButton/cap>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -8
        float physics:upperLimit = 0
    }
}

